<h1>{{titulo}}</h1>

<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Matricula</th>
            <th>Turma</th>
        </tr>
    </thead>
    <tbody>
        {{#each alunos}}
            <tr>
                <td>{{this.id}}</td>
                <td>{{this.nome}}</td>
                <td>{{this.matricula}}</td>
                <td>{{this.turma}}</td>
            </tr>
        {{else}}
            <tr>
                <td colspan="4">Nenhum aluno cadastrado.</td>
            </tr>
        {{/each}}
    </tbody>
</table>


