<h1>Cadastrar Novo Aluno</h1>

{{#if mensagemErro}}
    <div style="background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
        <strong>Atenção:</strong> {{mensagemErro}}
    </div>
{{/if}}


<form action="/alunos/cadastrar" method="POST">
    <div>
        <label for="id">ID:</label><br>
        <input type="number" id="id" name="id" value="{{dadosPrevios.id}}">
    </div>

    <div>
        <label for="nome">Nome:</label><br>
        <input type="text" id="nome" name="nome" value="{{dadosPrevios.nome}}">
    </div>

    <div>
        <label for="matricula">Matrícula:</label><br>
        <input type="text" id="matricula" name="matricula" value="{{dadosPrevios.matricula}}">
    </div>

    <div>
        <label for="turma">Turma</label><br>
        <input type="text" id="turma" value="{{dadosPrevios.turma}}" name="turma" >
    </div>

    <br>
    <button type="submit">Salvar Aluno</button>
    <a href="/alunos">Cancelar</a>
    <a href="/">Voltar</a>
</form>