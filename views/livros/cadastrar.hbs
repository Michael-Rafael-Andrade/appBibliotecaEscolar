<h1>Cadastrar Novo Livro</h1>

{{#if mensagemErro}}
    <div style="background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 4px; margin-bottom: 15px">
       <strong>Atenção:</strong> {{mensagemErro}} 
    </div>
{{/if}}

<!-- Formulário que envia os dados via POST para a rota /livros/cadastrar -->
<form action="/livros/cadastrar" method="POST">
    <div>
        <label for="id">ID do Exemplar:</label><br>
        <input type="number" id="id" name="id" value="{{dadosPrevios.id}}">
    </div>

    <div>
        <label for="titulo">Título:</label><br>
        <input type="text" id="titulo" name="titulo" value="{{dadosPrevios.titulo}}">
    </div>

    <div>
        <label for="autor">Autor:</label><br>
        <input type="text" id="autor" name="autor" value="{{dadosPrevios.autor}}">
    </div>

    <div>
        <label for="isbn">ISBN:</label><br>
        <input type="text" id="isbn" name="isbn" value="{{dadosPrevios.isbn}}">
    </div>

    <br>
    <button type="submit">Salvar Livro</button>
    <a href="/livros">Cancelar</a>
    <a href="/">Voltar</a>
</form>